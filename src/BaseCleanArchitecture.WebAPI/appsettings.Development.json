{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=BaseCleanArchitecture;Username=postgres;Password=postgres;"
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Provider": "RabbitMQ",
    "KafkaOptions": {
      "BootstrapServers": "localhost:9092",
      "Topic": "default-topic"
    },
    "RabbitMQOptions": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672
    }
  }
}
