{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=BaseCleanArchitecture;Username=postgres;Password=YourPassword;"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "BaseCleanArchitecture",
    "Audience": "BaseCleanArchitecture",
    "SecretKey": "super-secret-key-with-minimum-32-characters-long!!",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AdminSeed": {
    "Email": "admin@root.com",
    "Password": "Admin123@",
    "Username": "admin",
    "FullName": "Administrator"
  },
  "Audit": {
    "ChannelCapacity": 10000,
    "MaxBodyBytes": 1048576,
    "BatchSize": 100,
    "WriteRetries": 3,
    "RetryDelayMs": 200
  },
  "AuditEncryption": {
    "Key": "cmHZl1P7OlnRc4kxdHfPsX6LyVI4NfJ1opt7UISg2x8="
  },
  "Messaging": {
    "Provider": "Kafka",
    "KafkaOptions": {
      "BootstrapServers": "localhost:9092",
      "Topic": "default-topic"
    },
    "RabbitMQOptions": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672
    }
  },
  "EmailOptions": {
